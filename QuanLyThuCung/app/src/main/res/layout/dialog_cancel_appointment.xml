<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_dialog"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_padding"
    android:paddingTop="@dimen/spacing_md"
    android:paddingEnd="@dimen/screen_padding"
    android:paddingBottom="@dimen/spacing_xl">

    <!-- Drag Handle Indicator -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/spacing_md"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <!-- Dialog Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_stat_icon_accent">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_cancel"
                app:tint="@color/color_error" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xác nhận hủy lịch hẹn"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Hành động này không thể hoàn tác"
                android:textColor="@color/color_error"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:text="Bạn có chắc chắn muốn hủy lịch hẹn này không? Vui lòng chọn lý do hủy:"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <!-- Reason RadioGroup -->
    <RadioGroup
        android:id="@+id/rgCancelReasons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm">

        <RadioButton
            android:id="@+id/rbCustomerRequest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:paddingStart="@dimen/spacing_xs"
            android:text="Khách hàng yêu cầu hủy"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rbCustomerNoShow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/spacing_xs"
            android:text="Khách không thể đến"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rbStoreUnavailable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/spacing_xs"
            android:text="Nhân viên/cửa hàng không thể phục vụ"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rbMistakenBooking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/spacing_xs"
            android:text="Đặt nhầm lịch"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rbOtherReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/spacing_xs"
            android:text="Lý do khác"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </RadioGroup>

    <!-- Optional Note field for "Lý do khác" -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilOtherReasonNote"
        style="@style/Widget.PetStore.TextInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:hint="Nhập lý do chi tiết..."
        android:visibility="gone">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etOtherReasonNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:maxLines="3" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Dialog Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:orientation="vertical">

        <!-- Destructive confirmation button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmCancelAppointment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/color_error"
            android:minHeight="@dimen/touch_target_min"
            android:text="Xác nhận hủy"
            android:textAppearance="@style/TextAppearance.PetStore.Button"
            android:textColor="@color/white"
            app:cornerRadius="@dimen/radius_button"
            app:icon="@drawable/ic_cancel"
            app:iconGravity="textStart"
            app:iconTint="@color/white" />

        <!-- Secondary Dismiss button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDismissCancelDialog"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:minHeight="@dimen/touch_target_min"
            android:text="Quay lại"
            android:textAppearance="@style/TextAppearance.PetStore.Button"
            android:textColor="@color/text_primary"
            app:cornerRadius="@dimen/radius_button"
            app:strokeColor="@color/border_color" />
    </LinearLayout>

</LinearLayout>
