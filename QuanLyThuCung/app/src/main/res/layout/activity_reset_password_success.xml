<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingTop="@dimen/spacing_xl"
        android:paddingBottom="@dimen/spacing_xl">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSuccessContainer"
            style="@style/Widget.PetStore.FormCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/color_surface_variant"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border_color"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/spacing_xl">

                <!-- Paw Icon Branding -->
                <FrameLayout
                    android:id="@+id/cardPawContainer"
                    android:layout_width="@dimen/brand_paw_container_size"
                    android:layout_height="@dimen/brand_paw_container_size"
                    android:layout_marginBottom="@dimen/spacing_md"
                    android:background="@drawable/bg_brand_paw_container">

                    <ImageView
                        android:id="@+id/ivPawLogo"
                        android:layout_width="@dimen/brand_paw_icon_size"
                        android:layout_height="@dimen/brand_paw_icon_size"
                        android:layout_gravity="center"
                        android:adjustViewBounds="true"
                        android:contentDescription="PetStoreApp Paw Icon"
                        android:scaleType="fitCenter"
                        android:src="@drawable/petstore_paw_icon" />
                </FrameLayout>

                <!-- Success Icon Badge -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSuccessBadge"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginBottom="@dimen/spacing_lg"
                    app:cardBackgroundColor="@color/color_secondary_container"
                    app:cardCornerRadius="32dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/ivSuccessCheck"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="14dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="Thành công"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_check_circle"
                        app:tint="@color/color_secondary" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Title -->
                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Đặt lại mật khẩu thành công"
                    android:textAppearance="@style/TextAppearance.PetStore.Title"
                    android:textColor="@color/color_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- Subtitle / Message -->
                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:layout_marginBottom="@dimen/spacing_xl"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:maxWidth="280dp"
                    android:text="Mật khẩu của bạn đã được cập nhật. Bạn có thể đăng nhập ngay bây giờ."
                    android:textAppearance="@style/TextAppearance.PetStore.BodySecondary"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <!-- Login Action Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogin"
                    style="@style/Widget.PetStore.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Đăng nhập"
                    app:cornerRadius="@dimen/radius_button"
                    app:icon="@drawable/ic_arrow_forward"
                    app:iconGravity="textEnd"
                    app:iconPadding="8dp"
                    app:iconTint="@color/white" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
