<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Primary Button Style -->
    <style name="Widget.PetStore.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@color/color_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:textAppearance">@style/TextAppearance.PetStore.Button</item>
    </style>

    <!-- Secondary Button Style -->
    <style name="Widget.PetStore.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:backgroundTint">@color/color_secondary_container</item>
        <item name="android:textColor">@color/color_secondary</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:textAppearance">@style/TextAppearance.PetStore.Button</item>
    </style>

    <!-- Card Style -->
    <style name="Widget.PetStore.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardBackgroundColor">@color/color_surface</item>
        <item name="cardElevation">2dp</item>
    </style>

    <!-- Form Container Card Style -->
    <style name="Widget.PetStore.FormCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardBackgroundColor">@color/color_surface</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/border_color</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Section Container Style (visually separated block) -->
    <style name="Widget.PetStore.SectionCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardBackgroundColor">@color/color_surface</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/border_color</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Section Header Label Style -->
    <style name="Widget.PetStore.SectionHeader" parent="android:TextAppearance">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/color_primary</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <!-- Brand Paw Container Style (Circular Shape for Standalone Paw Icon) -->
    <style name="Widget.PetStore.BrandPawContainer" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/radius_chip</item>
        <item name="cardBackgroundColor">@color/brand_paw_container_background</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/brand_paw_badge_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Shared Auth TextInput Style -->
    <style name="Widget.PetStore.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/color_surface</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_input</item>
        <item name="boxStrokeColor">@color/sl_input_box_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxStrokeErrorColor">@color/color_error</item>
        <item name="errorTextColor">@color/color_error</item>
        <item name="errorIconTint">@color/color_error</item>
        <item name="hintTextColor">@color/color_primary</item>
        <item name="startIconTint">@color/text_secondary</item>
        <item name="endIconTint">@color/text_secondary</item>
        <item name="expandedHintEnabled">false</item>
    </style>

    <!-- Alias for Auth TextInput -->
    <style name="Widget.PetStore.Auth.TextInput" parent="Widget.PetStore.TextInput" />

    <!-- Chip Style -->
    <style name="Widget.PetStore.Chip" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="chipCornerRadius">@dimen/radius_chip</item>
        <item name="chipBackgroundColor">@color/color_secondary_container</item>
        <item name="chipIconTint">@color/color_secondary</item>
        <item name="android:textAppearance">@style/TextAppearance.PetStore.Caption</item>
    </style>
</resources>
